# Dependances
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build et cache
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.turbo/
.swc/

# Secrets et environnement
# Aucun secret de production ne doit entrer dans ce depot public.
# Seul .env.example est versionne, avec les noms et les formats, jamais les valeurs.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets

# Tests et couverture
coverage/
.nyc_output/
playwright-report/
playwright/.cache/
test-results/
blob-report/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Base de donnees locale et sauvegardes
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
backups/
pg-data/

# Medias locaux et televersements
# Les photographies de production ne sont pas versionnees, elles vivent
# chez l'hebergeur de medias. Les originaux peuvent contenir des metadonnees.
public/uploads/
uploads/
# Les declinaisons servies, ADR-007 : elles vivent sur le volume Docker
# `lune-soleil-medias` et jamais dans le depot, qui est public. Une execution
# locale du traitement les ecrit ici, et sans cette ligne elles seraient
# commitees. Ajoutee en LS-105, la section ne couvrait que les originaux.
public/medias/
tmp/
.tmp/

# Documents comptables generes
# Les factures et avoirs contiennent des donnees personnelles des clients.
invoices/
credit-notes/
*.pdf
!docs/**/*.pdf

# Documents internes non publiables
# Le cahier des charges et le plan directeur contiennent l'adresse du domicile
# de l'exploitante, son identite complete et le numero de formalite du Guichet
# unique. Ils restent hors du depot public, decision actee.
docs/prive/
docs/internal/

# Outils et editeurs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Assistant de developpement
# Les reglages partages de .claude sont versionnes, les reglages locaux non.
.claude/settings.local.json
.claude/*.local.json
.mcp.local.json

# Client Prisma fabrique
# Prisma 7 ne depose plus le client dans node_modules, `output` est obligatoire.
# Ce dossier est du code genere, reconstruit par `prisma generate` : le versionner
# noierait le diff utile de chaque PR touchant au schema sous des milliers de
# lignes fabriquees.
/src/generated/prisma

# Divers
.vercel
.sentryclirc
*.tgz

# Etats de session ouverts par les tests Playwright, LS-81 et LS-111. Ils
# portent un cookie de session valide, invariant 9 : le depot est public, et ils
# se recreent a chaque execution.
#
# UN MOTIF ET NON TROIS LIGNES NOMINATIVES, corrige le 2 septembre 2026. La
# liste ecrite a la main ne couvrait pas `.session-verifiee.json`, produit par
# le travail e2e de LS-56 : un cookie de session valide se trouvait donc hors
# du filtre, qu'un `git add -A` aurait pousse sur un depot public. Une liste
# ecrite a la main est une opinion tant qu'elle n'est pas generique, motif deja
# rencontre sur ce projet.
tests/e2e/.session-*.json

# Cookie signe de la commande de test, LS-118. Meme raison : une valeur signee
# avec le secret local n'a rien a faire dans un depot public.
tests/e2e/.commande-test.json
